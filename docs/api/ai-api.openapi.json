{
  "components": {
    "schemas": {
      "ChatMessage": {
        "description": "A single message replayed from the conversation history.",
        "properties": {
          "content": {
            "description": "Message content",
            "maxLength": 8000,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "description": "Message role: 'user' or 'assistant'",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "ChatRequest": {
        "description": "Incoming chat request body.",
        "properties": {
          "history": {
            "description": "Previous conversation messages for context",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "maxItems": 40,
            "title": "History",
            "type": "array"
          },
          "message": {
            "description": "Current user message",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Travel AI World \u2014 AI API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ai/chat": {
      "post": {
        "description": "Stream a chat completion for the authenticated user.\n\nWire format, one JSON object per `data:` line, terminated by `[DONE]`:\n\n    data: {\"content\": \"Hola\"}\n    data: {\"error\": \"...\"}\n    data: [DONE]\n\nThe `system` prompt is inserted server-side; clients may only send\n`user` and `assistant` turns.",
        "operationId": "chat_api_v1_ai_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Chat",
        "tags": [
          "Chat"
        ]
      }
    },
    "/api/v1/ai/health/": {
      "get": {
        "operationId": "health_check_api_v1_ai_health__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/ai/health/provider": {
      "get": {
        "description": "503 (via ProviderUnavailable) when the AI provider is not configured.",
        "operationId": "provider_health_api_v1_ai_health_provider_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Provider Health",
        "tags": [
          "Health"
        ]
      }
    }
  }
}
