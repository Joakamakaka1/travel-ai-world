# App Config
PROJECT_NAME="Travel AI World — Core API"
API_V1_STR="/api/v1"

# Security
# REQUIRED. Must be the SAME value in ai_api/.env (both verify the same JWTs).
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# Google OAuth 2.0 (REQUIRED)
# Get yours at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Frontend URL (for CORS; set to the deployed frontend in production)
FRONTEND_URL="http://localhost:3000"

# PostgreSQL (the only supported engine)
# Local: 127.0.0.1. Docker Compose and the devcontainer override DB_SERVER themselves.
DB_SERVER="127.0.0.1"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD=""
DB_NAME="postgres"
