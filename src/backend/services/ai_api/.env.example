# App Config
PROJECT_NAME="Travel AI World — AI API"
API_V1_STR="/api/v1"

# Security
# REQUIRED. Must be the SAME value as core_api/.env: this service verifies
# the JWTs core_api issues. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
ALGORITHM="HS256"

# NVIDIA AI Chat (REQUIRED)
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=""
NVIDIA_CHAT_MODEL="moonshotai/kimi-k2.6"

# core_api base URL (used when AI output has to be persisted)
# Docker Compose: http://core_api:8000 — local: http://localhost:8000
CORE_API_URL="http://localhost:8000"

# CORS — frontend origins (JSON list)
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
FRONTEND_URL="http://localhost:3000"
